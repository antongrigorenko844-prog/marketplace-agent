  "intent_taxonomy": {
    "3": "Сравнение цены, состояния, производителя",
    "7": "Другой товар/коробка/общая навигация",
    "8": "Смешанный или неоднозначный запрос",
    "2": "Подбор детали и применимости",
    "4": "Диагностика с возможной покупкой",
    "6": "Информация и самостоятельное обслуживание",
    "1": "Покупка конкретной детали/семейства",
    "5": "Явный поиск услуги/исполнителя/стоимости работы"
  },
  "usage_boundary": "Annotations are a review queue, not API-ready negatives, actual conversion attribution, or proof of compatibility."
}
